MICROBIN_BIND=0.0.0.0
MICROBIN_PORT=8080
MICROBIN_DATA_DIR=/app/pasta_data
MICROBIN_JSON_DB=true
MICROBIN_PUBLIC_PATH=https://b64.top
MICROBIN_SHORT_PATH=https://b64.top
MICROBIN_TITLE=b64.top · 随手分享
MICROBIN_QR=true
MICROBIN_HASH_IDS=true
MICROBIN_HIDE_LOGO=true
MICROBIN_ADMIN_USERNAME=
MICROBIN_ADMIN_PASSWORD=
MICROBIN_DEFAULT_PRIVACY=public
MICROBIN_EDITABLE=true
MICROBIN_ETERNAL_PASTA=true
MICROBIN_DEFAULT_EXPIRY=never
MICROBIN_MAX_EXPIRY=never
MICROBIN_GC_DAYS=0
MICROBIN_ENCRYPTION_CLIENT_SIDE=false
MICROBIN_ENCRYPTION_SERVER_SIDE=false
MICROBIN_DISABLE_TELEMETRY=true
MICROBIN_DISABLE_UPDATE_CHECKING=true
MICROBIN_MAX_FILE_SIZE_UNENCRYPTED_MB=2048
